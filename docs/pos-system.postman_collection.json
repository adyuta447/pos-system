    {
      "name": "Subscriptions & Licenses (Superadmin)",
      "item": [
        {
          "name": "List Subscriptions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.subscriptions && data.subscriptions[0] && data.subscriptions[0].id) {",
