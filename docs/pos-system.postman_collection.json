                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/admin/subscriptions?status=pending",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "subscriptions"],
              "query": [{ "key": "status", "value": "pending" }]
            }
          }
        },
        {
          "name": "Confirm Subscription & Issue Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  if (data.license && data.license.id) {",
                  "    pm.collectionVariables.set('license_id', data.license && data.license.id);",
                  "  }",
                  "  if (data.license && data.license.license_key) {",
                  "    pm.collectionVariables.set('license_key', data.license && data.license.license_key);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
